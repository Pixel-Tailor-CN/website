---
import { site } from '@/config/site';

const principles = [
  {
    title: '原生体验',
    description: '尽量贴近 Pixel 与原生 Android 的交互方式，让工具自然融入系统。',
    color: 'bg-google-blue/10 text-[#185ABC] dark:text-google-blue',
    icon: '<path d="M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z"></path><path d="M11 18h2"></path>',
  },
  {
    title: '本地优先',
    description: '能在设备端完成的识别与处理，尽量不依赖远端服务。',
    color: 'bg-google-green/10 text-[#137333] dark:text-google-green',
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"></path><path d="M9 12h6"></path>',
  },
  {
    title: '隐私至上',
    description: '敏感权限只服务于对应功能，具体规则以各应用隐私政策为准。',
    color: 'bg-google-yellow/10 text-[#725C00] dark:text-google-yellow',
    icon: '<rect width="18" height="11" x="3" y="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>',
  },
];
---

<section id="about" class="scroll-mt-20 bg-surface-container border-y border-outline-variant/30">
  <div class="mx-auto max-w-6xl px-5 sm:px-8 py-16 sm:py-20">
    <div class="max-w-3xl">
      <p class="text-sm font-medium text-primary tracking-wider">关于</p>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-on-surface">
        由独立开发者发起的开源工具集。
      </h2>
      <p class="mt-4 text-base text-on-surface-variant leading-relaxed">
        本项目由 <span class="font-semibold text-on-surface">{site.author.name}</span>（{site.author.org} 组织）发起，致力于为 Pixel 设备在国内的使用场景提供更顺手的小工具。
      </p>
      <p class="mt-3 text-base text-on-surface-variant leading-relaxed">
        所有应用均在 GitHub 开源，欢迎反馈与共建。
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={site.author.github} target="_blank" rel="noopener noreferrer" class="m3-btn-outlined">
          访问 GitHub 组织
        </a>
      </div>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-3" aria-label="项目原则">
      {principles.map((principle) => (
        <article class="rounded-(--radius-m3-lg) border border-outline-variant/30 bg-surface-container-low p-5 sm:p-6">
          <div class={`flex h-11 w-11 items-center justify-center rounded-full ${principle.color}`}>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true" set:html={principle.icon}></svg>
          </div>
          <h3 class="mt-5 text-lg font-semibold text-on-surface">{principle.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">{principle.description}</p>
        </article>
      ))}
    </div>

    <aside class="mt-12 rounded-(--radius-m3-lg) border border-outline-variant/30 bg-surface-container-low p-5 sm:p-6" role="note" aria-label="法律免责声明">
      <div class="flex flex-col sm:flex-row sm:items-center gap-4">
        <div class="shrink-0 w-10 h-10 rounded-full bg-google-yellow/10 text-[#725C00] dark:text-google-yellow flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
            <path d="M12 9v4"></path><path d="M12 17h.01"></path>
          </svg>
        </div>
        <div>
          <h3 class="text-base font-semibold text-on-surface">法律免责声明</h3>
          <div class="mt-1 flex flex-col sm:flex-row sm:flex-wrap sm:gap-x-6 gap-y-1 text-sm text-on-surface-variant">
            <p>Pixel-Tailor-CN 是一个独立的开源项目，与 Google LLC 无任何关联。</p>
            <p>“Pixel” 是 Google LLC 的注册商标。</p>
          </div>
        </div>
      </div>
    </aside>
  </div>
</section>
