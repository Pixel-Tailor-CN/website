---
import { apps } from '@/config/apps';
import { site } from '@/config/site';
---

<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute -top-32 -left-24 w-[420px] h-[420px] rounded-full bg-google-blue/20 blur-3xl"></div>
    <div class="absolute top-12 -right-24 w-[360px] h-[360px] rounded-full bg-google-yellow/20 blur-3xl"></div>
    <div class="absolute -bottom-24 left-1/3 w-[420px] h-[420px] rounded-full bg-google-green/20 blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-6xl px-5 sm:px-8 pt-16 sm:pt-24 pb-12 sm:pb-20">
    <div class="grid items-center gap-14 lg:grid-cols-[minmax(0,1.25fr)_minmax(320px,0.75fr)]">
      <div>
        <img
          src={site.logo}
          alt={`${site.name} 标志`}
          class="h-14 sm:h-16 w-auto"
          loading="eager"
        />

        <h1 id="hero-title" class="mt-8 max-w-3xl text-4xl sm:text-6xl font-bold tracking-tight text-on-surface">
          补齐 Pixel 在国内使用时缺的那一环
        </h1>

        <p class="mt-5 max-w-2xl text-lg sm:text-xl text-on-surface-variant">
          {site.description}
        </p>
        <p class="mt-3 text-base font-medium text-on-surface-variant/80">
          {site.tagline}
        </p>

        <ul class="mt-8 flex flex-wrap gap-2" aria-label="项目特点">
          <li class="inline-flex items-center h-8 px-3.5 rounded-full border border-google-blue/25 bg-google-blue/8 text-[#185ABC] dark:text-google-blue text-sm font-medium">
            原生 Android 体验
          </li>
          <li class="inline-flex items-center h-8 px-3.5 rounded-full border border-google-green/25 bg-google-green/8 text-[#137333] dark:text-google-green text-sm font-medium">
            隐私至上
          </li>
          <li class="inline-flex items-center h-8 px-3.5 rounded-full border border-google-yellow/30 bg-google-yellow/10 text-[#725C00] dark:text-google-yellow text-sm font-medium">
            Material You 适配
          </li>
        </ul>

        <div class="mt-10 flex flex-wrap gap-3">
          <a href="#apps" class="m3-btn-filled">
            浏览原点系列
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
              <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
          <a href={site.author.github} target="_blank" rel="noopener noreferrer" class="m3-btn-text">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.699-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48A10.001 10.001 0 0022 12c0-5.523-4.477-10-10-10z"></path>
            </svg>
            GitHub
          </a>
          <a href={site.author.telegram} target="_blank" rel="noopener noreferrer" class="m3-btn-text">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true">
              <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.896-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"></path>
            </svg>
            Telegram
          </a>
        </div>
      </div>

      <div class="relative hidden min-h-[360px] lg:block" aria-hidden="true">
        <div class="absolute inset-6 rounded-[48px] border border-outline-variant/30 bg-surface-container/70 shadow-m3-2 backdrop-blur-sm"></div>
        {apps.map((app, index) => {
          const positions = [
            'left-2 top-20 -rotate-6',
            'left-32 top-2 rotate-4',
            'right-2 top-24 rotate-6',
            'left-20 bottom-2 rotate-3',
            'right-20 bottom-4 -rotate-4',
          ];
          return (
            <div class={`absolute ${positions[index]} w-24 h-24 rounded-[28px] border border-outline-variant/35 bg-surface-container-lowest p-3 shadow-m3-2`}>
              <img src={app.icon} alt="" class="w-full h-full rounded-[20px] object-cover" loading="eager" />
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
