---
/** 主题切换按钮：浅色 → 深色 → 跟随系统 */
---

<button
  id="theme-toggle"
  type="button"
  class="m3-btn-icon"
  aria-label="当前为跟随系统主题；切换到浅色主题"
  title="当前：跟随系统；下一项：浅色"
  data-mode="system"
>
  <svg data-theme-icon="light" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden w-5 h-5" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
  <svg data-theme-icon="dark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden w-5 h-5" aria-hidden="true">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
  <svg data-theme-icon="system" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true">
    <rect width="20" height="14" x="2" y="3" rx="2"></rect><path d="M8 21h8"></path><path d="M12 17v4"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    const button = document.getElementById('theme-toggle');
    if (!(button instanceof HTMLButtonElement)) return;

    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const modes = ['light', 'dark', 'system'];
    const names = { light: '浅色', dark: '深色', system: '跟随系统' };

    function getMode() {
      try {
        const stored = localStorage.getItem('theme');
        return stored === 'light' || stored === 'dark' ? stored : 'system';
      } catch (_) {
        return 'system';
      }
    }

    function render(mode) {
      const dark = mode === 'dark' || (mode === 'system' && media.matches);
      document.documentElement.classList.toggle('dark', dark);
      document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', dark ? '#141218' : '#FEF7FF');

      button.dataset.mode = mode;
      button.querySelectorAll('[data-theme-icon]').forEach((icon) => {
        icon.classList.toggle('hidden', icon.getAttribute('data-theme-icon') !== mode);
      });

      const next = modes[(modes.indexOf(mode) + 1) % modes.length];
      button.setAttribute('aria-label', `当前为${names[mode]}主题；切换到${names[next]}主题`);
      button.title = `当前：${names[mode]}；下一项：${names[next]}`;
    }

    function store(mode) {
      try {
        if (mode === 'system') localStorage.removeItem('theme');
        else localStorage.setItem('theme', mode);
      } catch (_) {
        /* no-op */
      }
    }

    render(getMode());

    button.addEventListener('click', () => {
      const current = button.dataset.mode || getMode();
      const next = modes[(modes.indexOf(current) + 1) % modes.length];
      store(next);
      render(next);
    });

    media.addEventListener('change', () => {
      if ((button.dataset.mode || getMode()) === 'system') render('system');
    });
  })();
</script>
